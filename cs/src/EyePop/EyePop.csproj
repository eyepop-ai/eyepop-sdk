<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>EyePop.Sdk</PackageId>
    <!-- Placeholder: the release tag is the only version source, tasks pass -p:Version=. -->
    <Version>0.0.0</Version>
    <Authors>EyePop</Authors>
    <Description>.NET client for the EyePop pipeline API. Pre-release: the pipeline API is not implemented yet.</Description>
    <PackageTags>eyepop;computer-vision;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eyepop-ai/eyepop-sdk</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/eyepop-ai/eyepop-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Symbols and SourceLink (the SDK adds SourceLink for GitHub repos). -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
