{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eyepop.ai/pipeline-socket/v1/roi.json",
  "title": "roi",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "rectangle" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "required": ["type", "x", "y", "width", "height"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "contour" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "points"],
      "additionalProperties": false
    }
  ]
}
